# ============================================================
# Snail AI 环境变量配置
# ============================================================
# 使用方式：复制此文件为 .env，并修改为你的本地实际路径
#   cp .env.example .env
#
# 注意：.env 文件不会被提交到 Git（已在 .gitignore 中排除）
# ============================================================

# 前端项目（snail-ai-admin）本地源码路径
# 用于前端编码智能体/技能定位 Vue 3 + TypeScript 前端项目
SNAIL_AI_FRONTEND_PATH=D:\workspace-open\snail-ai-admin

# Gitee 个人访问令牌（用于自动创建 PR）
# 获取方式：Gitee → 设置 → 私人令牌 → 生成新令牌 → 勾选 projects 权限
# 仅在使用"提 PR"命令时需要
GITEE_TOKEN=

# ============================================================
# Snail AI Docker Compose（script/docker/docker-compose.yml）
# ============================================================

# --- 源码构建路径 ---
# snail-ai-starter 源码目录（相对于 script/docker/）
SNAIL_AI_STARTER_PATH=../../snail-ai-starter
# snail-ai-agent-example 源码目录（相对于 script/docker/）
SNAIL_AI_AGENT_EXAMPLE_PATH=../../snail-ai-agent-example

# --- Snail AI Server 配置 ---
# 数据库驱动（MySQL: com.mysql.cj.jdbc.Driver / PostgreSQL: org.postgresql.Driver）
SNAIL_AI_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# 数据库连接（MySQL 示例）
SNAIL_AI_DATASOURCE_URL=jdbc:mysql://localhost:3306/snail_ai?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8&useUnicode=true
# 数据库连接（PostgreSQL 示例，取消注释并注释上面 MySQL 行）
# SNAIL_AI_DATASOURCE_URL=jdbc:postgresql://localhost:5432/snail_ai?allowMultiQueries=true
SNAIL_AI_DATASOURCE_USERNAME=root
SNAIL_AI_DATASOURCE_PASSWORD=123456
# 加密密钥（16 位 hex）
SNAIL_AI_CRYPTO_KEY=0123456789abcdef0123456789abcdef
SNAIL_AI_CRYPTO_IV=fedcba9876543210fedcba9876543210

# --- Snail AI Agent 连接配置 ---
SNAIL_AI_SERVER_HOST=127.0.0.1
SNAIL_AI_SERVER_PORT=18888
SNAIL_AI_APP_ID=snail-ai-agent-demo
SNAIL_AI_TOKEN=SAI_ad27bd9de937499c8387336c8deb4cf0
SNAIL_AI_AGENT_PORT=18889
SNAIL_AI_AGENT_HOST=127.0.0.1

# ============================================================
# Tools Docker Compose（可选）
# ============================================================

# Docling API
DOCLING_PORT=5100
DOCLING_TASK_TTL=3600
DOCLING_MAX_CONCURRENCY=3
DOCLING_DOWNLOAD_MODELS=true
DOCLING_HF_ENDPOINT=https://hf-mirror.com
DOCLING_API_KEY=
SNAIL_AI_RAG_DOCLING_URL=http://docling-api:5100
SNAIL_AI_RAG_DOCLING_PADDLE_OCR_URL=http://paddle-ocr-api:8866/ocr

# PaddleOCR API
PADDLE_OCR_PORT=8866
PADDLE_OCR_LANG=ch
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_CPU_THREADS=1
PADDLE_OCR_USE_TEXTLINE_ORIENTATION=true
PADDLE_OCR_TEXT_RECOGNITION_BATCH_SIZE=
PADDLE_OCR_TEXTLINE_ORIENTATION_BATCH_SIZE=
PADDLE_OCR_API_KEY=
PADDLE_OCR_MAX_IMAGE_MB=20
PADDLE_OCR_MAX_CONCURRENCY=1
PADDLE_OCR_QUEUE_TIMEOUT_SECONDS=300
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_FLAGS_USE_MKLDNN=0
PADDLE_OMP_NUM_THREADS=1
PADDLE_OPENBLAS_NUM_THREADS=1
PADDLE_MKL_NUM_THREADS=1

# PaddlePaddle Docker build args
DEBIAN_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PYTORCH_CPU_WHEEL_BASE=https://mirrors.aliyun.com/pytorch-wheels/cpu
PADDLEPADDLE_VERSION=3.2.2
PADDLEPADDLE_PACKAGE=paddlepaddle
PADDLEPADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cpu/
