# Docling API
DOCLING_PORT=5100
DOCLING_TASK_TTL=3600
DOCLING_MAX_CONCURRENCY=3
DOCLING_DOWNLOAD_MODELS=true
DOCLING_HF_ENDPOINT=https://hf-mirror.com
DOCLING_API_KEY=

# PaddleOCR API
PADDLE_OCR_PORT=8866
PADDLE_OCR_LANG=ch
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_CPU_THREADS=1
PADDLE_OCR_USE_TEXTLINE_ORIENTATION=true
PADDLE_OCR_TEXT_RECOGNITION_BATCH_SIZE=
PADDLE_OCR_TEXTLINE_ORIENTATION_BATCH_SIZE=
PADDLE_OCR_API_KEY=
PADDLE_OCR_MAX_IMAGE_MB=20
PADDLE_OCR_MAX_CONCURRENCY=1
PADDLE_OCR_QUEUE_TIMEOUT_SECONDS=300
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_FLAGS_USE_MKLDNN=0
PADDLE_OMP_NUM_THREADS=1
PADDLE_OPENBLAS_NUM_THREADS=1
PADDLE_MKL_NUM_THREADS=1

# PaddlePaddle Docker build args
DEBIAN_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PYTORCH_CPU_WHEEL_BASE=https://mirrors.aliyun.com/pytorch-wheels/cpu
PADDLEPADDLE_VERSION=3.2.2
PADDLEPADDLE_PACKAGE=paddlepaddle
PADDLEPADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cpu/

# Snail AI container URLs inside the Compose network
SNAIL_AI_RAG_DOCLING_URL=http://docling-api:5100
SNAIL_AI_RAG_DOCLING_PADDLE_OCR_URL=http://paddle-ocr-api:8866/ocr
