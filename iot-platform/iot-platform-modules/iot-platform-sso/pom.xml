<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>iot-platform-modules</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>iot-platform-sso</artifactId>

    <description>
        单点登录模块：全平台统一认证、票据签发与校验
    </description>

    <dependencies>
        <!-- IoT 公共模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-platform-common</artifactId>
        </dependency>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-core</artifactId>
        </dependency>

        <!-- 接口模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-doc</artifactId>
        </dependency>

        <!-- 数据库服务（OAuth2 客户端注册表） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-mybatis</artifactId>
        </dependency>

        <!-- JSON 工具（OAuth2/CAS 报文处理） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-json</artifactId>
        </dependency>

        <!-- 安全模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-security</artifactId>
        </dependency>

        <!-- web服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-web</artifactId>
        </dependency>

        <!-- 日志记录 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-log</artifactId>
        </dependency>

        <!-- excel（OAuth2 客户端导出） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-excel</artifactId>
        </dependency>

        <!-- Sa-Token 登录能力 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-satoken</artifactId>
        </dependency>

        <!-- Sa-Token OAuth2 服务端（版本由 sa-token-bom 统一管理） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-oauth2</artifactId>
        </dependency>

        <!-- 缓存服务（SSO 票据存储） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-redis</artifactId>
        </dependency>
    </dependencies>

</project>
