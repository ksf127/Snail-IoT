<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>iot-platform-modules</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>iot-platform-report</artifactId>

    <description>
        报表模块：统计报表、批量上传与下载
    </description>

    <dependencies>
        <!-- IoT 公共模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-platform-common</artifactId>
        </dependency>
        <!-- 设备模型（统计与批量导入导出设备/产品） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-platform-device</artifactId>
        </dependency>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-core</artifactId>
        </dependency>

        <!-- 接口模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-doc</artifactId>
        </dependency>

        <!-- 数据库服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-mybatis</artifactId>
        </dependency>

        <!-- web服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-web</artifactId>
        </dependency>

        <!-- 安全模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-security</artifactId>
        </dependency>

        <!-- 日志记录 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-log</artifactId>
        </dependency>

        <!-- excel（批量导入导出） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-excel</artifactId>
        </dependency>

        <!-- 缓存服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-redis</artifactId>
        </dependency>

        <!-- 对象存储（报表文件、批量导入文件） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-oss</artifactId>
        </dependency>

        <!-- Elasticsearch（设备数据海量时序聚合统计） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-elasticsearch</artifactId>
        </dependency>
    </dependencies>

</project>
