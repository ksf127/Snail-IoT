<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>iot-platform-modules</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>iot-platform-deploy</artifactId>

    <description>
        自动化部署模块：应用发布编排、部署记录
    </description>

    <dependencies>
        <!-- IoT 公共模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-platform-common</artifactId>
        </dependency>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-core</artifactId>
        </dependency>

        <!-- 接口模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-doc</artifactId>
        </dependency>

        <!-- 数据库服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-mybatis</artifactId>
        </dependency>

        <!-- web服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-web</artifactId>
        </dependency>

        <!-- 安全模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-security</artifactId>
        </dependency>

        <!-- 日志记录 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-log</artifactId>
        </dependency>

        <!-- 缓存服务（部署锁、进度） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-redis</artifactId>
        </dependency>

        <!-- 对象存储（安装包 / 制品，阿里云 OSS 走 S3 协议） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>iot-common-oss</artifactId>
        </dependency>
    </dependencies>

</project>
